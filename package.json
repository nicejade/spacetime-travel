{
  "name": "spacetime-travel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c cyan,magenta \"pnpm api\" \"pnpm client\"",
    "client": "vite --host 0.0.0.0 --port 5167 --strictPort",
    "api": "tsx watch server/src/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"server/test/**/*.test.ts\" \"client/**/*.test.ts\" \"shared/**/*.test.ts\"",
    "smoke:visit-origin": "node --import tsx scripts/smoke-visit-origin.mjs",
    "build:gazetteer": "node scripts/build-gazetteer.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop spacetime-travel",
    "pm2:restart": "pm2 restart spacetime-travel",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --update-env",
    "pm2:logs": "pm2 logs spacetime-travel",
    "pm2:status": "pm2 status spacetime-travel",
    "deploy": "pnpm pm2:reload"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@lucide/svelte": "^1.17.0",
    "@tailwindcss/vite": "^4.1.0",
    "better-sqlite3": "^11.10.0",
    "d3-geo": "^3.1.1",
    "fastify": "^5.6.1",
    "svelte": "^5.0.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.22.4",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.1",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^9.1.2",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
