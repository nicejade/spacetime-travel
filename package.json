{
  "name": "spacetime-travel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c cyan,magenta \"pnpm api\" \"pnpm client\"",
    "client": "vite --host 0.0.0.0 --port 5167 --strictPort",
    "api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build:gazetteer": "node scripts/build-gazetteer.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.17.0",
    "@tailwindcss/vite": "^4.1.0",
    "better-sqlite3": "^11.10.0",
    "d3-geo": "^3.1.1",
    "express": "^5.1.0",
    "svelte": "^5.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.1",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^9.1.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
